# MarketSphere Environment Configuration Example
# Copy this file to .env and adjust variables for your local or production deployment.

# Node.js Express Backend
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api/v1
JWT_SECRET=super-secret-jwt-key-marketsphere-at-least-32-chars-long!
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-refresh-key-marketsphere-very-secure!
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=marketsphere_user
DB_PASSWORD=marketsphere_secret_pass
DB_NAME=marketsphere_db
DATABASE_URL=postgresql://marketsphere_user:marketsphere_secret_pass@localhost:5432/marketsphere_db

# Redis Caching & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Python Pricing & Recommendation Service
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_PORT=8000

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# Third-party Integrations (Sandbox Credentials)
STRIPE_WEBHOOK_SECRET=whsec_marketsphere_test_webhook_secret_key_12345
PAYMENT_SANDBOX_MODE=true
SHIPPING_WEBHOOK_SECRET=shipsec_marketsphere_test_shipping_key_67890
SMTP_HOST=smtp.sandbox.marketsphere.local
SMTP_PORT=587
SMTP_USER=no-reply@marketsphere.local
SMTP_PASSWORD=sandbox_smtp_password
STORAGE_BUCKET_NAME=marketsphere-assets
STORAGE_ENDPOINT=http://localhost:9000
